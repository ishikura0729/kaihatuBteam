<!DOCTYPE html>
<html>
  <head>
    <title>TeamB</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "announcements", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      

      <% if current_user&.role == 1 %>
        <%= link_to "シフト登録", new_shift_path %>
        <%= link_to "シフト編集", shifts_path %>
        <%= link_to "ユーザー管理", users_path %>
      <% end %>

      <%= link_to "シフト閲覧", shifts_path %>
      <%= link_to "お知らせ", announcements_path %>

      <%= button_to "ログアウト", logout_path, method: :delete %>
    </nav>

    <hr>
    <%= yield %>
  </body>
</html>
