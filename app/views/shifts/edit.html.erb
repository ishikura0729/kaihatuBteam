<div class = "edit_header">
    <h1>シフト編集</h1>
    <div class = "delete_button">
        <%= button_to "削除", shift_path(@shift), method: :delete,  data: { turbo_confirm: "本当に削除しますか?" } %>
    </div>
</div>

</div>

<% if notice.present? %>
    <p><%= notice %></p>
<% end %>


<%= form_with(model: @shift) do |form| %>
    <div>
        <%= form.collection_select :login_id,  User.all, :login_id, :name, style: "display: block" %>
    </div><br>

    <div>
        <%= form.label :work_date, "日付", style: "display: block" %>
        <%= form.date_field :work_date %>
    </div><br>

    <div>
        <%= form.label :start_time, "出勤時間", style: "display: block" %>
        <%= form.time_field :start_time %>
    </div><br>

    <div>
        <%= form.label :end_time, "退勤時間", style: "display: block" %>
        <%= form.time_field :end_time %>
    </div><br>

    <div>
        <%= form.submit "変更" %>
    </div>

<% end %>


