<h1>ログイン</h1>

<% flash.each do |key, message| %>
  <p style="color:red;"><%= message %></p>
<% end %>

<%= form_with url: login_path, method: :post do |f| %>

  <div>
    <%= f.label :login_id, "ログインID" %><br>
    <%= f.text_field :login_id %>
  </div>

  <br>

  <div>
    <%= f.submit "ログイン" %>
  </div>
  
<% end %>
