<div class="s-container">

  <h1 class="s-title"><%= @announcement.title %></h1>
  
  <div class="s-content">
    <p style="color: #666;">
      <small>公開日: <%= @announcement.created_at.strftime('%Y/%m/%d %H:%M') %></small>
    </p>

    <%# simple_formatを使うと、本文内の改行がそのままブラウザでも改行されます %>
    <div class="s-content-font"><%= @announcement.content %></div>
  </div>

  <div style="margin-top: 40px; border-top: 1px solid #eee; padding-top: 20px;">
    <%= link_to '編集する', edit_announcement_path(@announcement), class: "s-edit-btn" %>
    <%= link_to '一覧に戻る', announcements_path, class: "s-back-btn" %>
  </div>
</div>