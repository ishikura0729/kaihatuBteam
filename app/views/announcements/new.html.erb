<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
  <h1>お知らせ新規登録</h1>

  <%# エラーメッセージがある場合に表示 %>
  <% if @announcement.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <h2><%= @announcement.errors.count %>件のエラーがあります。</h2>
      <ul>
        <% @announcement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 登録用フォーム %>
  <%= form_with(model: @announcement, local: true) do |form| %>
    <div style="margin-bottom: 15px;">
      <%= form.label :title, 'タイトル', style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= form.text_field :title, style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :content, '本文', style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= form.text_area :content, rows: 5, style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
    </div>

    <div>
      <%= form.submit '登録する', style: "padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
      <%= link_to '戻る', announcements_path, style: "margin-left: 15px; color: #666; text-decoration: none;" %>
    </div>
  <% end %>
</div>