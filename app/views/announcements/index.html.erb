<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
  <nav>
    <ul>
      <li><%= link_to "シフト閲覧", shifts_path %></li>
      <li><%= link_to "シフト登録", new_shift_path %></li>
      <li><a href="#">お知らせ</a></li> 
    </ul>
  </nav>

  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>お知らせ一覧</h1>
    <%= link_to '新規登録画面へ', new_announcement_path %>
  </div>

  <% if flash[:notice] %>
    <p style="color: green;"><%= flash[:notice] %></p>
  <% end %>

  <hr>

  <% @announcements.each do |announcement| %>
    <div style="margin-bottom: 20px;">
      <h2><%= link_to announcement.title, announcement_path(announcement) %></h2>
      <p><small>公開日: <%= announcement.created_at.strftime('%Y/%m/%d') %></small></p>
    </div>

    <div style="margin-top: 5px;">
        <%= link_to '削除', announcement_path(announcement), 
                    data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, 
                    style: "color: #dc3545; text-decoration: none; font-size: 14px;" %>
    </div>
    <hr>
  <% end %>
</div>