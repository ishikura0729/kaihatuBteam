
<div class="container">
  <div class="header-area">
    <h1 class="page-title">お知らせ一覧</h1>
    <%= link_to '新規登録画面へ', new_announcement_path, class: "btn-primary" %>

<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
  <nav>
    <ul>
      <li><a href="#">ホーム</a></li>
      <li><a href="#">シフト登録</a></li>
      <li><a href="#">お知らせ</a></li> 
    </ul>
  </nav>

  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>お知らせ一覧</h1>
    <%= link_to '新規登録画面へ', new_announcement_path %>

  </div>

  <% if flash[:notice] %>
    <p style="color: #9bffbf;"><%= flash[:notice] %></p>
  <% end %>

  <hr>

  <% @announcements.each do |announcement| %>
    <div class="announcement-card">
      <h2 class="card-title"><%= link_to announcement.title, announcement_path(announcement) %></h2>
      <p class="card-date"><small>公開日: <%= announcement.created_at.strftime('%Y/%m/%d') %></small></p>
    </div>

    <div style="margin-top: 5px;">
        <%= link_to '削除', announcement_path(announcement), 
                    data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, 
                    style: "color: #e6407d; text-decoration: none; font-size: 14px;" %>
    </div>
    <hr>
  <% end %>
</div>